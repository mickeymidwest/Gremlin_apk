# Secrets -- never let these into git history
.env

# Generated at runtime, not source
data/*.jsonl
data/archive/
data/*.txt
data/.gremlin.lock
data/talking.marker
data/.sudo_credential
*.gremlin-backup-*

# Downloaded model weights -- large binaries, not source, and can
# always be re-downloaded via `gremlin models` / `gremlin models --hf`
models/*.gguf

# Standard Python/venv noise
__pycache__/
*.pyc
venv/
.venv/

# android/ is part of this same repo now, tracked alongside the
# desktop files -- only its generated build artifacts are excluded,
# same as the desktop side's own venv/__pycache__ exclusions above.
android/.gradle/
android/**/build/

# llama.cpp checkout -- only used for its convert_hf_to_gguf.py +
# quantize tooling when finetune.py promotes a new fine-tuned GGUF,
# not project source. Re-clonable, not something to track.
tools/llama.cpp/

# Per-conversation short-term memory (survives restarts, wiped on 'clear')
data/conversations/
# Runtime data written by research/bench/council -- not source
data/*.json
data/research_queue.jsonl
data/bench_results.jsonl
data/research_results.jsonl

# Fine-tuned checkpoints/merges/GGUFs -- tens of GB, regenerable via
# `gremlin finetune --target=<model>`, never something to push to GitHub.
data/finetunes/

# Curated source content, not runtime output -- exceptions to the
# data/*.txt and data/*.json blanket rules above.
!data/distill_prompts.txt
!data/submodel_base_repos.json

# Timestamped/one-off config backups from maintenance edits -- the real
# history is in git, these are just local safety nets during a change.
config/models.yaml.bak-*

# Magic build: model quality bench runtime output
bench/quality-*.jsonl
