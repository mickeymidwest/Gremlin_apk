<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phone guard (S3): see every installed app and what it can access.
         Fine for a sideloaded personal build; nothing leaves Mickey's machines. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Lets the app check "is there any network at all" before trying
         the desktop, so it can skip straight to standalone mode when
         there's clearly no connection (e.g. airplane mode) instead of
         waiting out a connect timeout for nothing. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <!-- Install the APK that Settings -> Builds pulls from the desktop.
         The user still gets the system installer's confirm screen; this
         just lets the app hand it the file. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
        </intent>
    </queries>

    <!-- Deliberately NOT requesting WRITE_EXTERNAL_STORAGE /
         READ_EXTERNAL_STORAGE: modern Android restricts and deprecates
         broad storage permissions, and Google Play flags apps that
         request them without a specific justified need. Chat history is
         saved to this app's own private storage (no permission needed
         at all, any Android version), and "Export Chat" uses the system
         file picker (Storage Access Framework) which also needs no
         manifest permission. Same real functionality, the way it's
         actually supposed to be done now. -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Gremlin"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: this talks to a plain http server on
             your own LAN, not https. Fine for a local personal setup,
             but worth knowing this app won't work over a public network
             without adding TLS on the desktop side too. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Gremlin Settings" />

        <activity
            android:name=".ModelSettingsActivity"
            android:exported="false"
            android:label="Model Settings" />

        <activity
            android:name=".BuildsActivity"
            android:exported="false"
            android:label="Desktop Builds" />

        <activity
            android:name=".SecurityActivity"
            android:exported="false"
            android:label="Phone &amp; desktop safety" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="How Mickey likes things"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ConversationsActivity"
            android:exported="false"
            android:label="Conversations" />

        <!-- Hands a downloaded build file (an .apk from Settings ->
             Builds) to the system installer via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
