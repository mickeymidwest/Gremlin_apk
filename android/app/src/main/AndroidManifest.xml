<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Lets the app check "is there any network at all" before trying
         the desktop, so it can skip straight to standalone mode when
         there's clearly no connection (e.g. airplane mode) instead of
         waiting out a connect timeout for nothing. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Overlay mode: the floating bubble that can sit on top of other
         apps (a browser doing homework, say) and read what's on screen.
         SYSTEM_ALERT_WINDOW is a special permission: it can't be
         granted by a normal runtime prompt, the user has to toggle it in
         a system settings screen, which SettingsActivity sends them to.
         The MEDIA_PROJECTION foreground-service type is required from
         API 29 on before getMediaProjection() will return anything. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Deliberately NOT requesting WRITE_EXTERNAL_STORAGE /
         READ_EXTERNAL_STORAGE: modern Android restricts and deprecates
         broad storage permissions, and Google Play flags apps that
         request them without a specific justified need. Chat history is
         saved to this app's own private storage (no permission needed
         at all, any Android version), and "Export Chat" uses the system
         file picker (Storage Access Framework) which also needs no
         manifest permission. Same real functionality, the way it's
         actually supposed to be done now. -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.Gremlin"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: this talks to a plain http server on
             your own LAN, not https. Fine for a local personal setup,
             but worth knowing this app won't work over a public network
             without adding TLS on the desktop side too. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Gremlin Settings" />

        <activity
            android:name=".ModelSettingsActivity"
            android:exported="false"
            android:label="Model Settings" />

        <activity
            android:name=".BuildsActivity"
            android:exported="false"
            android:label="Desktop Builds" />

        <!-- foregroundServiceType must be declared here as well as passed
             to startForeground(). On API 34+ a mismatch between the two
             is a hard crash, not a warning. -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Transparent shim that asks for screen-capture consent and
             hands the result to OverlayService. The consent dialog needs
             an Activity to return into, and the service can't be one. -->
        <activity
            android:name=".overlay.OverlayPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />
    </application>
</manifest>
