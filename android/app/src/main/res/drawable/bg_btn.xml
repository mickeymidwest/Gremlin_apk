<?xml version="1.0" encoding="utf-8"?>
<!-- Regular button: gradient frame, darker fill, ripple on press -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#337DFFCF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient android:angle="0"
                        android:startColor="@color/magic_accent"
                        android:endColor="@color/magic_blue" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="@color/magic_surface_hi" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
