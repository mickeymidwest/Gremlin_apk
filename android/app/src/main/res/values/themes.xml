<resources>
    <!-- Theme.MaterialComponents (no "DayNight") is the always-dark
         variant: deliberate here, not following system light/dark,
         since a white light-mode screen around the dark hologram
         widget would look broken rather than themed. -->
    <style name="Theme.Magic" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/magic_accent</item>
        <item name="colorPrimaryDark">@color/magic_bg</item>
        <item name="colorAccent">@color/magic_accent</item>
        <item name="android:windowBackground">@color/magic_bg</item>
        <item name="android:textColorPrimary">@color/magic_text_primary</item>
        <item name="android:textColorSecondary">@color/magic_text_secondary</item>
        <item name="android:textColorHint">@color/magic_text_secondary</item>
        <item name="colorSurface">@color/magic_surface</item>
        <item name="colorOnSurface">@color/magic_text_primary</item>
        <item name="colorOnPrimary">@color/magic_bg</item>
        <!-- 1.6 polish: every Button, card and text box picks these up -->
        <item name="materialButtonStyle">@style/Widget.Magic.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Magic.Card</item>
        <item name="editTextStyle">@style/Widget.Magic.EditText</item>
        <item name="android:editTextStyle">@style/Widget.Magic.EditText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Magic.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/magic_accent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- the one main action on a screen -->
    <style name="Widget.Magic.Button.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/magic_bg</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- full-width menu rows (Settings' top list) -->
    <style name="Widget.Magic.Button.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textColor">@color/magic_text_primary</item>
        <item name="android:background">@drawable/bg_row</item>
    </style>

    <style name="Widget.Magic.Card" parent="Widget.MaterialComponents.CardView">
        <!-- the frame and fill come from bg_card_gradient on the card's content -->
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Magic.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColorHint">@color/magic_text_secondary</item>
    </style>
</resources>
