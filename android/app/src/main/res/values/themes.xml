<resources>
    <!-- Theme.MaterialComponents (no "DayNight") is the always-dark
         variant: deliberate here, not following system light/dark,
         since a white light-mode screen around the dark hologram
         widget would look broken rather than themed. -->
    <style name="Theme.Gremlin" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/gremlin_accent</item>
        <item name="colorPrimaryDark">@color/gremlin_bg</item>
        <item name="colorAccent">@color/gremlin_accent</item>
        <item name="android:windowBackground">@color/gremlin_bg</item>
        <item name="android:textColorPrimary">@color/gremlin_text_primary</item>
        <item name="android:textColorSecondary">@color/gremlin_text_secondary</item>
        <item name="android:textColorHint">@color/gremlin_text_secondary</item>
        <item name="colorSurface">@color/gremlin_surface</item>
        <item name="colorOnSurface">@color/gremlin_text_primary</item>
        <item name="colorOnPrimary">@color/gremlin_bg</item>
        <!-- 1.6 polish: every Button, card and text box picks these up -->
        <item name="materialButtonStyle">@style/Widget.Gremlin.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Gremlin.Card</item>
        <item name="editTextStyle">@style/Widget.Gremlin.EditText</item>
        <item name="android:editTextStyle">@style/Widget.Gremlin.EditText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Gremlin.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/gremlin_surface_hi</item>
        <item name="android:textColor">@color/gremlin_accent</item>
        <item name="strokeColor">@color/gremlin_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- the one main action on a screen -->
    <style name="Widget.Gremlin.Button.Primary">
        <item name="backgroundTint">@color/gremlin_accent</item>
        <item name="android:textColor">@color/gremlin_bg</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- full-width menu rows (Settings' top list) -->
    <style name="Widget.Gremlin.Button.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textColor">@color/gremlin_text_primary</item>
        <item name="backgroundTint">@color/gremlin_surface_hi</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Gremlin.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/gremlin_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gremlin_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Gremlin.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColorHint">@color/gremlin_text_secondary</item>
    </style>
</resources>
