[Unit]
Description=Daily Gremlin defense report trigger

[Timer]
# Daily, clear of the zoid (22:00), distill (02:00), and backup (Sun
# 03:00) windows. Persistent=true catches up (runs shortly after boot)
# if the machine was off/asleep at the scheduled time instead of
# silently skipping that day entirely.
OnCalendar=*-*-* 04:00:00
Persistent=true

[Install]
WantedBy=timers.target
