#!/usr/bin/env bash
# Pre-push secret scan: abort the push if the commits being pushed look like
# they carry a secret. A safety net UNDER the unattended zoid/update auto-push.
# Override a genuine false positive:  GREMLIN_ALLOW_SECRETS=1 git push
# Installed by deploy/install-hooks.sh; canonical copy in deploy/hooks/.
set -u
Z=0000000000000000000000000000000000000000

# --- case-SENSITIVE: unambiguous key formats + the Tailscale CGNAT address ---
PAT_CS='-----BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY-----'
PAT_CS="$PAT_CS|AKIA[0-9A-Z]{16}"                            # AWS access key
PAT_CS="$PAT_CS|gh[po]_[A-Za-z0-9]{30,}"                     # GitHub token
PAT_CS="$PAT_CS|xox[baprs]-[A-Za-z0-9-]{10,}"                # Slack token
PAT_CS="$PAT_CS|sk-[A-Za-z0-9]{20,}"                         # OpenAI-style key
PAT_CS="$PAT_CS|AIza[0-9A-Za-z_-]{35}"                       # Google API key
PAT_CS="$PAT_CS|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}"

# --- case-INSENSITIVE: a secret-NAMED whole word assigned a QUOTED 20+ char
# high-entropy literal. The value class excludes / . and space, so a PATH
# ("/home/.../token") or a dotted identifier is NOT flagged; \b stops
# "tokenizer"/"token_file" from matching the "token" keyword. Q is a ["'] class
# built with ANSI-C escaping so no quote appears in this script. ---
Q=$'["\x27]'
PAT_CI="\\b(token|secret|passwd|password|apikey|api_key|access_key|auth_token|client_secret)\\b[^A-Za-z0-9]{1,6}${Q}[A-Za-z0-9_+=-]{20,}${Q}"

# the scanner's own files legitimately contain these patterns -- never scan them
EXC=":(exclude)deploy/hooks/pre-push :(exclude)tests/test_prepush_hook.py"

fail=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$Z" ] && continue
  if [ "$rsha" = "$Z" ]; then
    diff=$(git log -p --no-color "$lsha" --not --remotes -- . $EXC 2>/dev/null) \
      || { echo ">> secret-scan: git log failed; scan SKIPPED for $lref (check manually)" >&2; continue; }
  else
    # log -p (not diff): scans EVERY commit patch in the pushed range, so a
    # secret added then removed before the push is still caught (it's in the
    # history being pushed, hence exposed on the remote).
    diff=$(git log -p --no-color "$rsha..$lsha" -- . $EXC 2>/dev/null) \
      || { echo ">> secret-scan: git log failed; scan SKIPPED for $lref (check manually)" >&2; continue; }
  fi
  added=$(printf '%s\n' "$diff" | grep '^+[^+]')   # added lines only, not +++ headers
  hits=$({ printf '%s\n' "$added" | grep -nE  -e "$PAT_CS"
           printf '%s\n' "$added" | grep -niE -e "$PAT_CI"; } | head -40)
  if [ -n "$hits" ]; then
    echo "" >&2
    echo "PRE-PUSH BLOCKED by the secret scan -- a commit looks like it carries a secret:" >&2
    printf '%s\n' "$hits" | sed 's/^/   /' >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  if [ "${GREMLIN_ALLOW_SECRETS:-}" = "1" ]; then
    echo ">> GREMLIN_ALLOW_SECRETS=1 set -- allowing the push anyway." >&2
    exit 0
  fi
  echo "" >&2
  echo "Push aborted. Remove the secret (scrub history if it was committed)," >&2
  echo "or re-run with GREMLIN_ALLOW_SECRETS=1 git push if it's a false positive." >&2
  exit 1
fi
exit 0
