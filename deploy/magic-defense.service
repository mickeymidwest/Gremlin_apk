[Unit]
Description=Daily Magic defense report

[Service]
Type=oneshot
# Filled in by hand, same two lines as magic.service/magic-update.service.
WorkingDirectory=/home/YOUR_USERNAME/Downloads/gremlin
ExecStart=/home/YOUR_USERNAME/Downloads/gremlin/venv/bin/python -c "from magic_core.magic import defense; path, flagged = defense.write_report('.', repo_for_secrets='.'); print(f'wrote {path}' + (' -- FLAGGED, see /admin/defense or the file itself' if flagged else ' -- nothing flagged'))"
