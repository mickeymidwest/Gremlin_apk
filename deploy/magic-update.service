[Unit]
Description=Check for and pull Magic updates from GitHub

[Service]
Type=oneshot
# Filled in by install-all.sh -- see magic.service's WorkingDirectory
# for the same pattern. Edit these two if installing by hand instead.
WorkingDirectory=/home/YOUR_USERNAME/Downloads/gremlin
ExecStart=/home/YOUR_USERNAME/Downloads/gremlin/deploy/magic-update.sh
