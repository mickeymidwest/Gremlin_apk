# How scripts/heavy.sh pauses the live server daemon. Set ONE of these.

# Option A (best: actually frees RAM) — the daemon is a systemd user service:
#   DAEMON_SERVICE=gremlin-server.service
DAEMON_SERVICE=gremlin.service

# Option B — no service; match the daemon's command line with pgrep -f.
# heavy.sh will kill it and relaunch it with DAEMON_START_CMD afterwards.
#   DAEMON_PATTERN="python3 .*server.py"
#   DAEMON_START_CMD="nohup python3 server.py >> .gremlin/daemon.log 2>&1 &"
DAEMON_PATTERN=
DAEMON_START_CMD=

# Option C — no daemon on this machine. Set to 1 to run heavy commands directly.
DAEMON_NONE=0

# Commands the Claude hook treats as "heavy" (extended regex, matched anywhere in the command).
HEAVY_REGEX='(\./gradlew|(^|[[:space:];&|])gradle[[:space:]]|(^|[[:space:];&|])make([[:space:]]|$)|docker[[:space:]]+(build|compose[[:space:]]+build)|npm[[:space:]]+run[[:space:]]+build)'

# Timers paused during a heavy job, so they can't restart the daemon mid-build. Space-separated.
DAEMON_TIMERS="gremlin-watchdog.timer gremlin-update.timer"

# Polled after the restart; timers resume once it answers (any HTTP status), or after 180s.
DAEMON_READY_URL=http://127.0.0.1:8765/status
